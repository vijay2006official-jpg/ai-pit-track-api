# AI Pit Track API Configuration
PROJECT_NAME="AI Pit Track API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./pit_track.db"

# AI Detection Settings
YOLO_MODEL_PATH="./models_weights/pothole_yolo.pt"
DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_IOU_THRESHOLD=0.45
USE_CV_FALLBACK_IF_NO_WEIGHTS=true

# Spatial Clustered Tracking
GEO_DUPLICATION_RADIUS_METERS=7.0
